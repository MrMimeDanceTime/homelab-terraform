# ============================================================================
# Infisical Configuration
# ============================================================================
# NOTE: infisical_client_id and infisical_client_secret should NOT be set here
# Pass them via environment variables:
#   TF_VAR_infisical_client_id="your-client-id"
#   TF_VAR_infisical_client_secret="your-client-secret"

# Infisical workspace ID - get from Infisical dashboard
infisical_workspace_id = "your-workspace-id-here"

# Infisical environment (prod, dev, staging, etc.)
infisical_env = "prod"
infisical_k8s_workspace_id = "your-k8s-project-id-here"

# NOTE: Secrets are fetched from:
#   - /HIDDEN folder: pm_api_token_secret, ci_password
#   - /VISIBLE folder: ssh_key_pub

# ============================================================================
# Proxmox Configuration
# ============================================================================
proxmox_api_url = "https://proxmox.example:8006/api2/json"
proxmox_api_token_id = "terraform@pve!tofu"
# Set to true only if the Proxmox API uses a self-signed certificate.
proxmox_tls_insecure = false

# ============================================================================
# General Purpose VMs
# ============================================================================
vms = {
  "vm1" = {
    home_name     = "zeus"
    vm_id         = 200
    cpu_cores     = 2
    memory        = 4096
    balloon       = 2048
    disk_size     = 32
    template_name = "debian-13"
  }
  "minecraft-server" = {
    home_name     = "zeus"
    vm_id         = 300
    cpu_cores     = 12
    memory        = 16384
    balloon       = 2048
    disk_size     = 32
    template_name = "debian-13"
  }
}

# ============================================================================
# Jellyfin Media Server VMs (with GPU passthrough)
# ============================================================================
jellyfin_vms = {
  "mediadocker" = {
    home_name     = "apollo"
    vm_id         = 200
    cpu_cores     = 6
    memory        = 12288
    balloon       = 2048
    disk_size     = 512
    template_name = "debian-13"
  }
}

